# Enterprise Scalable Production Variables
resource_group_name = "rg-taskapp-prod"
location            = "eastus"
environment         = "production"

# Network CIDRs
vnet_cidr           = "10.100.0.0/16"
app_subnet_cidr     = "10.100.2.0/24"
db_subnet_cidr      = "10.100.3.0/24"

# Compute Scaling (VMSS)
vmss_sku            = "Standard_B2s"
vmss_min_instances  = 2
vmss_max_instances  = 5
admin_username      = "azureadmin"
ssh_public_key      = ""

# Managed PostgreSQL Flexible Server
db_sku_name         = "B_Standard_B2s"
db_admin_username   = "psqladmin"

