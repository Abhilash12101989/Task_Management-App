rg = {
  dev_rg = {
    name     = "rg-taskmanagement-dev"
    location = "Central India"
  }
}

vnet = {
  dev_vnet = {
    vnet_name          = "vnet-taskmanagement-dev"
    vnet_location      = "Central India"
    rg_key             = "dev_rg"
    vnet_address_space = ["10.0.0.0/16"]
  }
}

app_subnet = {
  app = {
    app_subnet_name             = "snet-app"
    rg_key                      = "dev_rg"
    vnet_key                    = "dev_vnet"
    app_subnet_address_prefixes = ["10.0.1.0/24"]
  }
}

db_subnet = {
  db = {
    db_subnet_name             = "snet-db"
    rg_key                     = "dev_rg"
    vnet_key                   = "dev_vnet"
    db_subnet_address_prefixes = ["10.0.2.0/28"]
  }
}

bastion_subnet = {
  bastion = {
    rg_key           = "dev_rg"
    vnet_key         = "dev_vnet"
    address_prefixes = ["10.0.3.0/26"]
  }
}

nsg = {
  # Key 'app' matches the key in app_subnet for automatic NSG-to-subnet association
  app = {
    name   = "nsg-taskmanagement-app-dev"
    rg_key = "dev_rg"
    security_rules = [
      {
        name                       = "Allow-HTTP"
        priority                   = 100
        direction                  = "Inbound"
        access                     = "Allow"
        protocol                   = "Tcp"
        source_port_range          = "*"
        destination_port_range     = "80"
        source_address_prefix      = "*"
        destination_address_prefix = "*"
      },
      {
        name                       = "Allow-HTTPS"
        priority                   = 110
        direction                  = "Inbound"
        access                     = "Allow"
        protocol                   = "Tcp"
        source_port_range          = "*"
        destination_port_range     = "443"
        source_address_prefix      = "*"
        destination_address_prefix = "*"
      },
      {
        name                       = "Allow-SSH"
        priority                   = 120
        direction                  = "Inbound"
        access                     = "Allow"
        protocol                   = "Tcp"
        source_port_range          = "*"
        destination_port_range     = "22"
        source_address_prefix      = "YOUR_PUBLIC_IP/32" # Replace with your public IP (e.g. "203.0.113.10/32")
        destination_address_prefix = "*"
      }
    ]
  }
}

public_ip = {
  app_pip = {
    name              = "pip-taskmanagement-app-dev"
    rg_key            = "dev_rg"
    allocation_method = "Static"
    sku               = "Standard"
  }
  bastion_pip = {
    name              = "pip-bas-taskmanagement-dev"
    rg_key            = "dev_rg"
    allocation_method = "Static"
    sku               = "Standard"
  }
}

bastion = {
  bas = {
    name          = "bas-taskmanagement-dev"
    rg_key        = "dev_rg"
    subnet_key    = "bastion"
    public_ip_key = "bastion_pip"
    sku           = "Basic"
  }
}

nic = {
  app_nic = {
    name                          = "nic-taskmanagement-vm-dev"
    rg_key                        = "dev_rg"
    subnet_key                    = "app"
    private_ip_address_allocation = "Dynamic"
    public_ip_key                 = "app_pip"
  }
}

vm = {
  app_vm = {
    name           = "vm-taskmanagement-dev"
    rg_key         = "dev_rg"
    nic_key        = "app_nic"
    size           = "Standard_B2s"
    admin_username = "azureuser"
    admin_password = "Password1234!"
    os_disk_type   = "Standard_LRS"
  }
}
