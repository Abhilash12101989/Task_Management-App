rg = {
  dev_rg = {
    name     = "rg-taskmanagement-dev"
    location = "eastus"
  }
}

vnet = {
  dev_vnet = {
    vnet_name          = "vnet-taskmanagement-dev"
    vnet_location      = "eastus"
    rg_key             = "dev_rg"
    vnet_address_space = ["10.0.0.0/16"]
  }
}

app_subnet = {
  app = {
    app_subnet_name             = "snet-app"
    rg_key                      = "dev_rg"
    vnet_key                    = "dev_vnet"
    app_subnet_address_prefixes = ["10.0.1.0/24"]
  }
}

db_subnet = {
  db = {
    db_subnet_name             = "snet-db"
    rg_key                     = "dev_rg"
    vnet_key                   = "dev_vnet"
    db_subnet_address_prefixes = ["10.0.2.0/24"]
  }
}

nsg = {
  # NSG for Single Application VM (Hosting both Frontend and Backend containers)
  app_nsg = {
    name   = "nsg-taskmanagement-app-dev"
    rg_key = "dev_rg"
    security_rules = [
      {
        name                       = "Allow-HTTP"
        priority                   = 100
        direction                  = "Inbound"
        access                     = "Allow"
        protocol                   = "Tcp"
        source_port_range          = "*"
        destination_port_range     = "80"
        source_address_prefix      = "*"
        destination_address_prefix = "*"
      },
      {
        name                       = "Allow-HTTPS"
        priority                   = 110
        direction                  = "Inbound"
        access                     = "Allow"
        protocol                   = "Tcp"
        source_port_range          = "*"
        destination_port_range     = "443"
        source_address_prefix      = "*"
        destination_address_prefix = "*"
      },
      {
        name                       = "Allow-SSH"
        priority                   = 120
        direction                  = "Inbound"
        access                     = "Allow"
        protocol                   = "Tcp"
        source_port_range          = "*"
        destination_port_range     = "22"
        source_address_prefix      = "*"
        destination_address_prefix = "*"
      },
      {
        name                       = "Allow-Frontend-Container-3000"
        priority                   = 130
        direction                  = "Inbound"
        access                     = "Allow"
        protocol                   = "Tcp"
        source_port_range          = "*"
        destination_port_range     = "3000"
        source_address_prefix      = "*"
        destination_address_prefix = "*"
      },
      {
        name                       = "Allow-FastAPI-Backend-8000"
        priority                   = 140
        direction                  = "Inbound"
        access                     = "Allow"
        protocol                   = "Tcp"
        source_port_range          = "*"
        destination_port_range     = "8000"
        source_address_prefix      = "*"
        destination_address_prefix = "*"
      }
    ]
  },

  # NSG for Database Tier (Strictly isolated to Application Subnet traffic)
  db_nsg = {
    name   = "nsg-taskmanagement-db-dev"
    rg_key = "dev_rg"
    security_rules = [
      {
        name                       = "Allow-Postgres-From-AppSubnet"
        priority                   = 100
        direction                  = "Inbound"
        access                     = "Allow"
        protocol                   = "Tcp"
        source_port_range          = "*"
        destination_port_range     = "5432"
        source_address_prefix      = "10.0.1.0/24"
        destination_address_prefix = "*"
      },
      {
        name                       = "Allow-SSH-From-AppSubnet"
        priority                   = 110
        direction                  = "Inbound"
        access                     = "Allow"
        protocol                   = "Tcp"
        source_port_range          = "*"
        destination_port_range     = "22"
        source_address_prefix      = "10.0.1.0/24"
        destination_address_prefix = "*"
      },
      {
        name                       = "Deny-All-Inbound-Default"
        priority                   = 4000
        direction                  = "Inbound"
        access                     = "Deny"
        protocol                   = "*"
        source_port_range          = "*"
        destination_port_range     = "*"
        source_address_prefix      = "*"
        destination_address_prefix = "*"
      }
    ]
  }
}
